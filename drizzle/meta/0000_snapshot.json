      "checkConstraints": {
        "locales_translation_status_check": {
          "name": "locales_translation_status_check",
          "value": "\"locales\".\"translation_status\" in ('draft', 'generating', 'partial', 'ready')"
        },
        "locales_publication_status_check": {
          "name": "locales_publication_status_check",
          "value": "\"locales\".\"publication_status\" in ('inactive', 'active', 'disabled')"
        },
        "locales_direction_check": {
          "name": "locales_direction_check",
          "value": "\"locales\".\"direction\" in ('ltr', 'rtl')"
        },
        "locales_native_name_check": {
          "name": "locales_native_name_check",
          "value": "btrim(\"locales\".\"native_name\") <> ''"
        },
        "locales_presentation_metadata_object_check": {
          "name": "locales_presentation_metadata_object_check",
          "value": "jsonb_typeof(\"locales\".\"presentation_metadata\") = 'object'"
        },
        "locales_non_bootstrap_tag_check": {
          "name": "locales_non_bootstrap_tag_check",
          "value": "lower(\"locales\".\"tag\") not in ('en', 'api', 'assets')"
        },
        "locales_fallback_chain_shape_check": {
          "name": "locales_fallback_chain_shape_check",
          "value": "(\n    cardinality(\"locales\".\"fallback_chain\") = 0\n    or (array_ndims(\"locales\".\"fallback_chain\") = 1 and array_lower(\"locales\".\"fallback_chain\", 1) = 1)\n  ) and array_position(\"locales\".\"fallback_chain\", null) is null"
        },
        "locales_aliases_shape_check": {
          "name": "locales_aliases_shape_check",
          "value": "(\n    cardinality(\"locales\".\"aliases\") = 0\n    or (array_ndims(\"locales\".\"aliases\") = 1 and array_lower(\"locales\".\"aliases\", 1) = 1)\n  ) and array_position(\"locales\".\"aliases\", null) is null"
        },
        "locales_match_tags_shape_check": {
          "name": "locales_match_tags_shape_check",
          "value": "(\n    cardinality(\"locales\".\"match_tags\") = 0\n    or (array_ndims(\"locales\".\"match_tags\") = 1 and array_lower(\"locales\".\"match_tags\", 1) = 1)\n  ) and array_position(\"locales\".\"match_tags\", null) is null"
        }
      },
