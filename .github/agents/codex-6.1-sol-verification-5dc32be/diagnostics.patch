+import { readFile, readdir } from "node:fs/promises";
+import { drizzle } from "drizzle-orm/node-postgres";
+import { Client } from "pg";
+import { afterAll, beforeAll, describe, expect, it } from "vitest";
+import { DrizzleForumAttachments } from "../../db/forum-attachments";
+import { ForumAttachmentCleanup } from "../../db/forum-attachment-cleanup";
+import { DrizzleForumRepository, ForumAuthorizationError, ForumStateConflictError } from "../../db/forum-repository";
+
+const databaseUrl = process.env.DATABASE_URL;
+if (!databaseUrl) throw new Error("DATABASE_URL is required");
+const url = new URL(databaseUrl);
+if (!["localhost", "127.0.0.1"].includes(url.hostname) || !url.pathname.endsWith("_test")) {
+  throw new Error("Disposable local test database required");
+}
+
+const schema = "candidate_findings_test";
+const connection = () => new Client({ connectionString: databaseUrl, options: `-c search_path=${schema}` });
+const client = connection();
+const attachments = new DrizzleForumAttachments(drizzle(client));
+const ownerId = "publication-owner";
+const sectionId = "publication-section";
+const topicId = "publication-topic";
+const contextKey = `topic:${topicId}:reply`;
+let clock = Date.parse("2030-01-01T00:00:00Z");
+const policy = { cooldownMs: 0, now: () => new Date(clock += 1) };
+const forum = new DrizzleForumRepository(drizzle(client), policy);
+
+function attachment(draftId: string, key = contextKey) {
+  return {
+    id: crypto.randomUUID(), ownerId, contextKey: key, draftId,
+    objectKey: `private/${crypto.randomUUID()}`,
+    fileName: "retained.txt", declaredMime: "text/plain", detectedType: "text",
+    responseMime: "text/plain; charset=utf-8", byteSize: 12,
+    verificationStatus: "type-checked" as const,
+  };
+}
+
+function reply(id: string, draftId?: string, expectedVersion?: number) {
+  return {
+    id, topicId, authorId: ownerId,
+    publishedDraft: { contextKey, ...(draftId ? { draftId, expectedVersion } : {}) },
+    bodyRevision: { id: `${id}-revision`, originalContent: "Reply text", sourceLocale: "en" },
+  };
+}
+
+function operation(draftId: string, contextKey = "topic:publication-topic:reply") { return {draftId, contextKey, version: 0}; }
+
+beforeAll(async () => {
+  await client.connect();
+  await client.query(`drop schema if exists ${schema} cascade; create schema ${schema}`);
+  const files = (await readdir("drizzle")).filter((file) => /^\d{4}_.+\.sql$/u.test(file)).sort();
+  for (const file of files) {
+    await client.query((await readFile(`drizzle/${file}`, "utf8")).replaceAll('"public".', `"${schema}".`));
+  }
+  for (const id of [ownerId, "publication-topic-author", "publication-other"]) {
+    await client.query('insert into "user" (id, name, email) values ($1, $1, $2)', [id, `${id}@test.invalid`]);
+  }
+  await forum.createCategory({ id: "publication-category", name: "Attachments" });
+  await forum.createSection({ id: sectionId, categoryId: "publication-category", name: "Files" });
+  await forum.createTopicWithInitialPost({
+    id: topicId, sectionId, authorId: "publication-topic-author",
+    titleRevision: { id: "publication-title", originalContent: "Topic", sourceLocale: "en" },
+    initialPost: {
+      id: "publication-initial", topicId, authorId: "publication-topic-author",
+      bodyRevision: { id: "publication-initial-body", originalContent: "Question", sourceLocale: "en" },
+    },
+  });
+});
+
+afterAll(async () => {
+  await client.query(`drop schema if exists ${schema} cascade`);
+  await client.end();
+});
+
+
+describe("candidate findings independent DB verification", () => {
+  for (const removeB of [false, true]) it(`L1 newest ref removed=${removeB}`, async () => {
+    const operationId=crypto.randomUUID(), a=attachment(operationId), b=attachment(operationId);
+    await attachments.createDraftAttachment(a); await attachments.createDraftAttachment(b);
+    const t0=new Date('2035-01-01T00:00:00Z');
+    await client.query('update forum_attachment_draft_refs set created_at=$1 where attachment_id=$2',[t0,a.id]);
+    await client.query('update forum_attachment_draft_refs set created_at=$1 where attachment_id=$2',[new Date(+t0+23*3600000),b.id]);
+    if(removeB) expect(await attachments.removeDraftAttachment(ownerId,contextKey,operationId,b.id)).toBe(true);
+    const deleted:string[]=[];
+    const cleanup=new ForumAttachmentCleanup(drizzle(client),{delete:async(key:string)=>{deleted.push(key);}},()=>new Date(+t0+24*3600000+1000));
+    const result=await cleanup.runOnce();
+    const refs=await client.query('select attachment_id from forum_attachment_draft_refs where draft_id=$1',[operationId]);
+    const terminal=await client.query('select 1 from forum_attachment_draft_generations where draft_id=$1',[operationId]);
+    console.log('L1',JSON.stringify({removeB,refsRemaining:refs.rowCount,terminal:terminal.rowCount,aPhysicallyDeleted:deleted.includes(a.objectKey),prunedRefs:result.prunedRefs}));
+    expect(terminal.rowCount).toBe(removeB?1:0);
+    expect(deleted.includes(a.objectKey)).toBe(removeB);
+    if(!removeB) await attachments.cancelOperation(ownerId,contextKey,operationId);
+    else await expect(attachments.createDraftAttachment(attachment(operationId))).rejects.toMatchObject({reason:'gone'});
+  });
+  it('L2 bare per-file DELETE before late upload does not fence its eventual ref; operation Cancel does',async()=>{
+    const op=crypto.randomUUID(),file=attachment(op);
+    expect(await attachments.removeDraftAttachment(ownerId,contextKey,op,file.id)).toBe(false);
+    await attachments.createDraftAttachment(file);
+    expect(await attachments.readDraftAttachment(ownerId,contextKey,op,file.id)).not.toBeNull();
+    await attachments.cancelOperation(ownerId,contextKey,op);
+    await expect(attachments.createDraftAttachment(file)).rejects.toMatchObject({reason:'gone'});
+    console.log('L2 delete-before-upload=false; late upload creates ref; whole-operation cancel fences retry');
+  });
+  it('L2 committed upload with lost response can be resolved by stable retry then removed without losing another file',async()=>{
+    const op=crypto.randomUUID(),a=attachment(op),b=attachment(op);
+    await attachments.createDraftAttachment(a);await attachments.createDraftAttachment(b);
+    const retry=await attachments.createDraftAttachment(b);
+    expect(retry.id).toBe(b.id);expect(retry.objectKey).toBe(b.objectKey);
+    expect(await attachments.removeDraftAttachment(ownerId,contextKey,op,b.id)).toBe(true);
+    expect(await attachments.readDraftAttachment(ownerId,contextKey,op,a.id)).not.toBeNull();
+    expect(await attachments.readDraftAttachment(ownerId,contextKey,op,b.id)).toBeNull();
+    await attachments.cancelOperation(ownerId,contextKey,op);
+    console.log('L2 existing safe path under recovered network: stable Retry -> ACK -> Remove, other A preserved');
+  });
+  for(const removeA of [false,true]) it(`L3 rebase explicit Remove A=${removeA}`,async()=>{
+    const firstOp=crypto.randomUUID(),a=attachment(firstOp),postId=crypto.randomUUID(),r1=crypto.randomUUID();
+    await attachments.createDraftAttachment(a);
+    await forum.createPost({...reply(postId,firstOp),publishedDraft:{contextKey,draftId:firstOp,attachmentIds:[a.id]},bodyRevision:{id:r1,originalContent:'Original',sourceLocale:'en'}});
+    const opB=crypto.randomUUID(),b=attachment(opB,`post:${postId}:edit`);
+    await attachments.createDraftAttachment(b);
+    await forum.editPublishedPost({postId,topicId,actorId:ownerId,expectedRevisionId:r1,body:'Other tab added B',draftId:opB,attachmentIds:[b.id],retainedAttachmentIds:[a.id]});
+    const r2=(await forum.readPost(postId))!.body.id;
+    expect(await attachments.readPublishedAttachment(postId,b.id)).not.toBeNull();
+    const editA={postId,topicId,actorId:ownerId,expectedRevisionId:r1,body:'Local text change',draftId:crypto.randomUUID(),attachmentIds:[],retainedAttachmentIds:removeA?[]:[a.id]};
+    await expect(forum.editPublishedPost(editA)).rejects.toBeInstanceOf(ForumStateConflictError);
+    expect(await attachments.readPublishedAttachment(postId,b.id)).not.toBeNull();
+    await forum.editPublishedPost({...editA,expectedRevisionId:r2});
+    expect(await attachments.readPublishedAttachment(postId,b.id)).toBeNull();
+    expect(!!await attachments.readPublishedAttachment(postId,a.id)).toBe(!removeA);
+    expect((await forum.readPost(postId))!.body.originalContent).toBe('Local text change');
+    console.log('L3',JSON.stringify({removeA,staleSaveRejected:true,rebasedSaveSucceeded:true,bPublicRefLost:true,aKept:!removeA,history:(await forum.readPostHistory(postId,topicId)).length}));
+  });
+});
