{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vico-forum",
  "compatibility_date": "2026-09-09",
  "main": "./workers/app.ts",
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "redact_query_string": true
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "aa1fb9feeff44a23ae12d88eefceb942"
    },
    {
      "binding": "WEB_HYPERDRIVE",
      "id": "a4e99f358a9f4953a7045db8f733974d"
    }
  ]
}
